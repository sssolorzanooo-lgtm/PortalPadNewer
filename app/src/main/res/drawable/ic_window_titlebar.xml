<!--
  Show or hide window title bar: a window outline with the title strip FILLED, so
  the icon is literally a picture of the thing the button toggles. Replaces the
  bare rectangle glyph, which said nothing (the button's label had already been
  renamed for the same ambiguity).
  The three dots in the strip's top-right are CUTOUTS (fillType evenOdd), not
  drawn dots - the whole icon is runtime-tinted one color, so anything drawn ON
  the filled strip would tint identically and vanish. They evoke the window
  control buttons (minimize / maximize / close) at the position they really sit,
  per SH's spec 2026-07-23. Keep them holes; do not "simplify" to filled circles.
  Mixes the filled strip with a stroked outline; runtime tint applies to both.
  Rendered by BOTH the top bar (ImageSpan) and the arrange wheel (ICONS map) -
  one file, both surfaces.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M5,5 L19,5 A2,2 0 0 1 21,7 L21,9.5 L3,9.5 L3,7 A2,2 0 0 1 5,5 Z M14.8,7.25 m-0.85,0 a0.85,0.85 0 1,0 1.7,0 a0.85,0.85 0 1,0 -1.7,0 Z M16.9,7.25 m-0.85,0 a0.85,0.85 0 1,0 1.7,0 a0.85,0.85 0 1,0 -1.7,0 Z M19,7.25 m-0.85,0 a0.85,0.85 0 1,0 1.7,0 a0.85,0.85 0 1,0 -1.7,0 Z"
        android:fillType="evenOdd"
        android:fillColor="#FFFFFFFF" />
    <path
        android:pathData="M5,5 L19,5 A2,2 0 0 1 21,7 L21,17 A2,2 0 0 1 19,19 L5,19 A2,2 0 0 1 3,17 L3,7 A2,2 0 0 1 5,5 Z"
        android:strokeWidth="2"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
</vector>
